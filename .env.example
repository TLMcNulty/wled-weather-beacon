# Copy to .env and fill in. .env is git-ignored.

# Home Assistant base URL and a long-lived access token (Profile > Security > Long-lived access tokens)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# IP or hostname of the WLED lamp
WLED_HOST=

# Optional
#WEATHER_ENTITY=weather.forecast_home
#MODE=glance          # glance | gradient
#HOURS=3              # forecast window in hours
#INTERVAL=600         # seconds between forecast fetches
#TREND_EVERY=60       # seconds between temperature flashes, 0 = off
#TREND_DEG=3          # change (in HA's temperature unit) that counts as warmer/colder
#TREND_STYLE=dip      # dip | flash | fade | overlay | off
